{
    "name": "sigmaphp/sigmaphp-db",
    "description": "PHP Database Tools",
	"keywords": [
        "SigmaPHP",
        "framework",
        "database",
        "orm",
        "migration",
        "seeder",
        "query builder"
    ],
    "type": "library",
	"license": "MIT",
    "autoload": {
        "psr-4": {
            "SigmaPHP\\DB\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SigmaPHP\\DB\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Mohamed Yousef",
            "email": "engineer.mohamed.yossef@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "doctrine/inflector": "2.*",
        "sigmaphp/sigmaphp-console": "^0.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "agashe/var-dumper": "^0.1.0"
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "cp src/Console/templates/database.php.dist database.php",
            "./vendor/bin/phpunit tests/",
            "rm database.php"
        ]
    },
    "bin": "bin/sigma-db"
}
