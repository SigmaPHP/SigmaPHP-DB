#!/usr/bin/env php
<?php

require 'vendor/autoload.php';

use SigmaPHP\Console\App;
use SigmaPHP\Console\DataType;
use SigmaPHP\Console\Option;

// define app version
const VERSION = "v0.1.16";

// initiate new console app
$app = new App();

$app->setAppDescription('CLI utilities for `SigmaPHP-DB`');
$app->setAppVersion(VERSION);

$app->addGlobalOption(
    'config',
    '',
    'Set config file path',
    Option::PARAMETER_REQUIRED,
    DataType::STRING
);

$app->addCommand(\SigmaPHP\DB\Commands\CreateConfig::class);
$app->addCommand(\SigmaPHP\DB\Commands\CreateMigration::class);
$app->addCommand(\SigmaPHP\DB\Commands\CreateModel::class);
$app->addCommand(\SigmaPHP\DB\Commands\CreateSeeder::class);
$app->addCommand(\SigmaPHP\DB\Commands\Drop::class);
$app->addCommand(\SigmaPHP\DB\Commands\Fresh::class);
$app->addCommand(\SigmaPHP\DB\Commands\Migrate::class);
$app->addCommand(\SigmaPHP\DB\Commands\Rollback::class);
$app->addCommand(\SigmaPHP\DB\Commands\Seed::class);
$app->addCommand(\SigmaPHP\DB\Commands\Truncate::class);

$app->run();
